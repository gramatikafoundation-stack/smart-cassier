{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-order-sdb.local/schema/tenant.config.v2.json",
  "title": "SMART ORDER SDB Tenant Configuration v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "tenant_slug",
    "business_name",
    "merchant_name",
    "merchant_name_acknowledged",
    "locale",
    "currency",
    "timezone",
    "canonical_origin",
    "surface_routes",
    "qris_asset",
    "table_count",
    "require_table_qr_signature",
    "menu_seed",
    "admin_owner_email",
    "spreadsheet_target",
    "storage",
    "sheets"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "tenant_id": { "type": "string", "format": "uuid" },
    "tenant_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "minLength": 3,
      "maxLength": 48
    },
    "business_name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "merchant_name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "merchant_name_acknowledged": { "type": "boolean" },
    "locale": { "type": "string", "minLength": 2, "maxLength": 32 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "timezone": { "type": "string", "minLength": 3, "maxLength": 64 },
    "canonical_origin": {
      "type": "string",
      "pattern": "^https://[^/]+/?$"
    },
    "surface_routes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public", "admin", "kds", "database"],
      "properties": {
        "public": { "const": "/" },
        "admin": { "const": "/admin" },
        "kds": { "const": "/kds" },
        "database": { "const": "/database" }
      }
    },
    "qris_asset": { "type": "string", "minLength": 1 },
    "table_count": { "type": "integer", "minimum": 1, "maximum": 200 },
    "require_table_qr_signature": { "const": true },
    "menu_seed": { "type": "string", "pattern": "^prototype/.+\\.json$" },
    "admin_owner_email": {
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$"
    },
    "spreadsheet_target": { "type": "string", "minLength": 3, "maxLength": 160 },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "static_bucket", "payment_bucket"],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "static_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "payment_bucket": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        }
      }
    },
    "sheets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "start_year", "years", "expected_tabs"],
      "properties": {
        "provider": { "const": "google_drive" },
        "start_year": { "type": "integer", "minimum": 2026, "maximum": 2100 },
        "years": { "type": "integer", "minimum": 1, "maximum": 10 },
        "expected_tabs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["DASHBOARD", "PEMESAN", "PESANAN", "MENU & STOK", "KEUANGAN"]
          }
        }
      }
    }
  }
}
