{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "git diff --name-only HEAD^ HEAD | grep -Eq '^(apps/public/|package.json$|package-lock.json$|pnpm-lock.yaml$|yarn.lock$)' && exit 1 || exit 0",
  "rewrites": [
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/manifest.webmanifest", "destination": "/api/manifest" },
    { "source": "/favicon.ico", "destination": "/api/brand-assets?kind=favicon" },
    { "source": "/apple-touch-icon.png", "destination": "/api/brand-assets?kind=apple" },
    { "source": "/icon-192.png", "destination": "/api/brand-assets?kind=icon192" },
    { "source": "/icon-512.png", "destination": "/api/brand-assets?kind=icon512" },
    { "source": "/og-image.png", "destination": "/api/brand-assets?kind=og" },
    { "source": "/ocr-worker.js", "destination": "/api/ocr-worker" },
    { "source": "/runtime-lifecycle.js", "destination": "/api/render-seo-brand?rohmat_runtime=lifecycle" },
    { "source": "/(.*)", "destination": "/api/render-seo-brand" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=()" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    }
  ]
}
